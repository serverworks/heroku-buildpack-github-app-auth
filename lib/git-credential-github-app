#!/usr/bin/env bash
set +x
set -euo pipefail

# Git の store / erase では保存しない。get 以外は入力を読まずに終了する。
[[ "${1:-}" == get ]] || exit 0

protocol= host= path=
while IFS='=' read -r key value; do
  [[ -n "$key" ]] || break
  case "$key" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
    path) path="$value" ;;
  esac
done

[[ "$protocol" == https && "$host" == github.com ]] || exit 0
IFS=',' read -r -a repositories <<< "${PRIVATE_GEMS_APP_REPOSITORIES:?PRIVATE_GEMS_APP_REPOSITORIES is not set}"
matched_repository=
for repository in "${repositories[@]}"; do
  case "$path" in
    "$repository"|"${repository}.git") matched_repository="$repository"; break ;;
  esac
done
[[ -n "$matched_repository" ]] || exit 0

script_dir="$(cd "$(dirname "$0")" && pwd)"
if ! token="$("$script_dir/create-github-app-token" "${PRIVATE_GEMS_APP_ENV_DIR:?PRIVATE_GEMS_APP_ENV_DIR is not set}")"; then
  # 対象 gem の認証失敗時は他の資格情報へ切り替えず、Git を失敗させる。
  printf 'quit=true\n\n'
  exit 1
fi

# stdout は Git の credential protocol 専用。ビルドログに出す用途では呼ばない。
printf 'username=x-access-token\npassword=%s\n\n' "$token"
